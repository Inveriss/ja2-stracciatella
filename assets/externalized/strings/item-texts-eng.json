[
    {
        "internalName": "Nothing",
        "shortName": "Nada",
        "name": "Nothing",
        "description": "JA 2 programmers are the best there are... oh.. well maybe not since this message should never come up...",
        "bobbyRayName": "Nothing",
        "bobbyRayDescription": "JA 2 programmers are the best there are... oh.. well maybe not since this message should never come up..."
    },
    {
        "internalName": "GLOCK_17",
        "shortName": "Glock 17",
        "name": "Glock 17",
        "description": "Favored by most military officers, this Austrian semi-automatic pistol is considered the defacto standard side-arm worldwide.",
        "bobbyRayName": "Glock 17",
        "bobbyRayDescription": "Even though most of this Austrian pistol's parts are plastic, it will get detected by airport x-ray machines. The simple design of this recoil operated self-loader contains only 32 components, and is a common army issue worldwide."
    },
    {
        "internalName": "GLOCK_18",
        "shortName": "Glock 18",
        "name": "Glock 18",
        "description": "As the fully automatic version of the Glock 17, this Austrian pistol was specifically designed for military use.",
        "bobbyRayName": "Glock 18",
        "bobbyRayDescription": "Of Austrian origin, the Glock 18 is deserving of the classification of machine pistol. As the Glock 17's successor, it was built to offer the option for automatic fire. Sorry, but parts from the Glock 17 and 18 are not interchangeable."
    },
    {
        "internalName": "BERETTA_92F",
        "shortName": "Beretta 92F",
        "name": "Beretta 92F",
        "description": "This Italian double action pistol can quickly turn any shooter into a Lethal Weapon.",
        "bobbyRayName": "Beretta 92F",
        "bobbyRayDescription": "U.S. Army issued, the Beretta 92F is a standard 9mm Parabellum pistol, with a modified trigger-guard to allow a two-handed grip. This is a very functional weapon."
    },
    {
        "internalName": "BERETTA_93R",
        "shortName": "Beretta 93R",
        "name": "Beretta 93R",
        "description": "The 92F's leaner and meaner cousin. This fully automatic machine pistol could be your best friend in a close range fire fight.",
        "bobbyRayName": "Beretta 93R",
        "bobbyRayDescription": "The most pistol you'll ever need. Classified as a machine pistol, it features a fold-down front grip and an extendible steel shoulder stock, that attaches at the rear of the butt, to facilitate three-round mode shooting."
    },
    {
        "internalName": "SW38",
        "shortName": ".38 S&W",
        "name": ".38 Special",
        "description": "Tried and true by the boys in blue. This American pistol is the most common police service revolver in the world.",
        "bobbyRayName": ".38 S&W Special",
        "bobbyRayDescription": "The standard Smith and Wesson military and police double-action revolver is ideal for both self-defense and offensive purposes. When the mainspring ages however, the gun is prone to light hammer blows."
    },
    {
        "internalName": "BARRACUDA",
        "shortName": "Barracuda",
        "name": "Barracuda",
        "description": "The preferred weapon of Dirty Harry's little brother, this Belgian revolver has found its way into many American police holsters.",
        "bobbyRayName": ".357 Barracuda",
        "bobbyRayDescription": "The Belgian .357 magnum Barracuda revolver is a powerful choice for both offense and defense. Numerous test trials have shown that both men and women find it easier to handle than most handguns."
    },
    {
        "internalName": "DESERTEAGLE",
        "shortName": "Desert Eagle",
        "name": "Desert Eagle",
        "description": "This former Israeli pistol that is about as subtle as a hand-held nuke, is now being produced in the good ol' USA.",
        "bobbyRayName": ".357 Desert Eagle",
        "bobbyRayDescription": "This single-action, power-packed, gas-operated pistol is one hundred per cent U.S. made. Originally produced in Israel, it features a rotating bolt for positive lock-up, an ambidextrous safety, a steel frame, and a nickel or chrome finish."
    },
    {
        "internalName": "M1911",
        "shortName": "Colt .45",
        "name": "Colt .45",
        "description": "The Almighty may have created man, but over the last century, this pistol has more than helped to keep them in line.",
        "bobbyRayName": "Colt .45",
        "bobbyRayDescription": "This American made automatic pistol of classic design, is one of the most successful combat pistols ever invented. A proven man-stopper, it creates a wide wound channel that can cause severe nerve trauma."
    },
    {
        "internalName": "MP5K",
        "shortName": "MP5K",
        "name": "H&K MP5K",
        "description": "This German sub-machine gun is the must-have weapon for Die Hard terrorists and two-bit South American drug lords.",
        "bobbyRayName": "H&K MP5K",
        "bobbyRayDescription": "Heckler and Koch's MP5K is one of the most compact and deadly German sub-machine guns around. Anti-terrorist groups and drug cartels love this weapon because it's so small and easy to use. This tiny weapon is easily hidden under clothing."
    },
    {
        "internalName": "MAC10",
        "shortName": "MAC-10",
        "name": "MAC-10",
        "description": "The American Uzi. Born in the days of disco, this weapon has been very popular in the land of pink flamingos and snow.",
        "bobbyRayName": ".45 MAC-10",
        "bobbyRayDescription": "The U.S. Military Armament Corp. Model-10: a real man's sub-machine gun. Its steadiness allows for single-handed firing and its threaded barrel can fit a 'sound suppressor,' which is similar to a silencer but won't reduce bullet velocity."
    },
    {
        "internalName": "THOMPSON",
        "shortName": "Thompson",
        "name": "Thompson M1A1",
        "description": "As the successor to the Tommy Gun, this weapon became very popular on the streets of prohibition-Chicago and the beaches of Normandy.",
        "bobbyRayName": "Thompson M1A1",
        "bobbyRayDescription": "Although heavier than most submachine guns, the 'Tommy Gun' is still favored by Commando and Ranger forces. None have been built since the 1960's, but they are still very common, and have definitely weathered the test of time."
    },
    {
        "internalName": "COMMANDO",
        "shortName": "Commando",
        "name": "Colt Commando",
        "description": "This mini version of the M-16 is a prized tool for knocking off noisy neighbors and petty dictators.",
        "bobbyRayName": "Colt Commando",
        "bobbyRayDescription": "Very small, and yet, very deadly. The Colt Commando is an attractively short and concealable assault rifle that was based on the M16 design. It is extremely popular among several US armed forces, including the DEA."
    },
    {
        "internalName": "MP53",
        "shortName": "MP53",
        "name": "H&K MP53",
        "description": "Heckler and Koch's latest addition to the submachine gun family is known for its excessive muzzle climb, making its use indoors inadvisable.",
        "bobbyRayName": "H&K MP53",
        "bobbyRayDescription": "This German sub-machine gun has a lethality and stopping power that is definitely disproportionate to its size. When fitted with a special flash suppresser, excessive muzzle flash that is common on short weapons, is eliminated."
    },
    {
        "internalName": "AKSU74",
        "shortName": "AKSU-74",
        "name": "AKSU-74",
        "description": "Commonly used by the Russian Spetsnaz, the muzzle flash from this SMG's short barrel has singed many an eyebrow.",
        "bobbyRayName": "AKSU-74",
        "bobbyRayDescription": "Russian in origin, this sub-machine gun is a shorter version of the AK-74. It's a combat intensive weapon with a bulbous muzzle attachment to compensate for firing 5.45mm Soviet rifle cartridges in a much shorter barrel."
    },
    {
        "internalName": "P90",
        "shortName": "P90",
        "name": "FN-P90",
        "description": "This Belgian weapon is one of the most advanced submachine guns in the world and is highly coveted by several special forces.",
        "bobbyRayName": "5.7mm FN-P90",
        "bobbyRayDescription": "Chews through Kevlar like it was butter. The FN-P90 is a blowback machine pistol with truly powerful ballistic capabilities. All controls are fully ambidextrous, with a cocking handle fitted on both sides and two open sights."
    },
    {
        "internalName": "TYPE85",
        "shortName": "Type-85",
        "name": "Type-85",
        "description": "Cheap, simple, and rugged. This motto for Chinese military designs is truly reflected in this mass-produced weapon.",
        "bobbyRayName": "Type-85",
        "bobbyRayDescription": "Of Chinese design, the Type-85 submachine gun is a plain blowback weapon that is remarkably lightweight due to its rotating bolt system. The weapon's manufacturers claim that it also fires the subsonic type-64 cartridge."
    },
    {
        "internalName": "SKS",
        "shortName": "SKS",
        "name": "SKS",
        "description": "This extremely common semi-automatic carbine weapon has seen action in  almost every Communist country in the world.",
        "bobbyRayName": "SKS",
        "bobbyRayDescription": "The Simonov self-loading SKS automatic rifle has a simple design and is easy to operate. Developed during WWII, it was later distributed to most Warsaw Pact members. Its only weak spot: it's a little heavy for its cartridge."
    },
    {
        "internalName": "DRAGUNOV",
        "shortName": "Dragunov",
        "name": "Dragunov",
        "description": "Reach out and touch someone the Russian Army way. This rifle has struck more than fear into the hearts of officers worldwide.",
        "bobbyRayName": "Dragunov",
        "bobbyRayDescription": "This Russian sniping rifle is known for its accuracy. Standard issues with the rifle are the PSO-1 telescope sight and the image-intensifying NSPU-3 night sight."
    },
    {
        "internalName": "M24",
        "shortName": "M24",
        "name": "M24",
        "description": "Call on the M-24 to deliver your 7.62mm package up to a mile away in two seconds flat. It guarantees delivery every time.",
        "bobbyRayName": "M24",
        "bobbyRayDescription": "The Remington M24 is the standard sniping rifle of the US Army. This bolt-action rifle's stock is made of synthetic material with an aluminum bedding lock and comes with an adjustable buttplate."
    },
    {
        "internalName": "AUG",
        "shortName": "Steyr",
        "name": "Steyr AUG",
        "description": "The 'Evil Assault Rifle' poster-child for US gun control lobbyists is the futuristic looking Austrian army standard rifle.",
        "bobbyRayName": "Steyr AUG",
        "bobbyRayDescription": "This Austrian automatic rifle has a unique modular design with many interchangeable parts. It was one of the first rifles to use a plastic firing mechanism as well as plastic furniture."
    },
    {
        "internalName": "G41",
        "shortName": "G41",
        "name": "H&K G41",
        "description": "Harder hitting than a hangover from a night of downing German lager, this G41 will quickly become your enemy's headache.",
        "bobbyRayName": "H&K G41",
        "bobbyRayDescription": "Built to NATO weapons standards, this assault rifle is a great piece of German engineering. It features an ejection port dust cover and a hold-open device to keep the bolt open when emptying the mag."
    },
    {
        "internalName": "MINI14",
        "shortName": "Mini-14",
        "name": "Ruger Mini-14",
        "description": "This Sturm Ruger rifle is a 70's era mechanical copy of the W.W.II Garand. It makes an ideal gift for the Survivalist in the family.",
        "bobbyRayName": "Ruger Mini-14",
        "bobbyRayDescription": "Considered to be the great American hunting rifle, it's perfect for paramilitary use. It naturally enhances your ability to hit on target because of its low recoil forces."
    },
    {
        "internalName": "C7",
        "shortName": "C-7",
        "name": "C-7",
        "description": "This rifle shouts the Canuck motto, 'Anything the Yanks can do, we can do better.' This version of the M-16 is every merc's dream come true.",
        "bobbyRayName": "C-7",
        "bobbyRayDescription": "It's the Canadian version of the American M16A2. Trust those crazy Canucks to incorporate such safety devices as a case deflector to prevent empty cases from being flung into the faces of left-handed firers."
    },
    {
        "internalName": "FAMAS",
        "shortName": "FA-MAS",
        "name": "FA-MAS",
        "description": "Nicknamed 'The Bugle' by French Army Troops, this bullpup rifle packs the utility of the M-16 in under two-and-a-half feet.",
        "bobbyRayName": "FA-MAS",
        "bobbyRayDescription": "The French Army's FA-MAS rifle was the first 'bullpup' design to enter military service. It handles well, and shoots quite accurately. A bipod can also be attached for steadier shooting."
    },
    {
        "internalName": "AK74",
        "shortName": "AK-74",
        "name": "AK-74",
        "description": "This rifle is destined to become one of Russia's greatest exports, second only to tactical nuclear warheads.",
        "bobbyRayName": "AK-74",
        "bobbyRayDescription": "Used as the Soviet infantry's standard automatic rifle, the AK-74 is a smaller caliber version of the AKM. While highly efficient and steady, with minimal recoil, it can be nasty to bystanders, as muzzle gases are diverted sideways."
    },
    {
        "internalName": "AKM",
        "shortName": "AKM",
        "name": "AKM",
        "description": "The AKM is the newest version of the infamous AK-47. This line of rifles has been used in Vietnam, Afghanistan, and many passenger jets.",
        "bobbyRayName": "AKM",
        "bobbyRayDescription": "As the modernized version of the AK-47 automatic rifle, it was one of the best and most widely distributed Soviet weapons. Designed for mass production, you'll find one of these automatic rifles slung over every frugal mercenary's shoulder."
    },
    {
        "internalName": "M14",
        "shortName": "M-14",
        "name": "M-14",
        "description": "The M-14 is about as All-American as apple pie and the 4th of July. Any A-Team equipped with this rifle is gunning for victory.",
        "bobbyRayName": "M-14",
        "bobbyRayDescription": "Truly American through and through. This lighter automatic rifle offers multiple firing options, but is best kept locked at semi-automatic. Unfortunately, without the ability to change its barrel, it can overheat with sustained firing."
    },
    {
        "internalName": "FNFAL",
        "shortName": "FN-FAL",
        "name": "FN-FAL",
        "description": "The phrase, 'Help, I've FAL-len and I can't get up,' takes on a whole new meaning when this rifle is involved.",
        "bobbyRayName": "FN-FAL",
        "bobbyRayDescription": "This Belgian automatic rifle set a new standard in weaponry in the early 1950's. Its robust and reliable design made it simple to use and maintain, despite its tendency for excessive climbing in automatic mode."
    },
    {
        "internalName": "G3A3",
        "shortName": "G3A3",
        "name": "H&K G3A3",
        "description": "Made from sheet metal stampings and plastic furniture, this ugly looking rifle delivers wounds that are equally foul.",
        "bobbyRayName": "H&K G3A3",
        "bobbyRayDescription": "Made from sheet metal stampings and plastic furniture, this Heckler and Koch automatic rifle sure ain't pretty, but it is definitely robust, reliable and highly effective."
    },
    {
        "internalName": "G11",
        "shortName": "G11",
        "name": "H&K G11",
        "description": "The Porsche of assault rifles. This rifle goes from 0 to 3 rounds in under a second, and tears through Kevlar like butter.",
        "bobbyRayName": "H&K G11",
        "bobbyRayDescription": "Germany's Heckler and Koch designed this weapon as the fastest automatic rifle around. Its high velocity shots tear right through Kevlar. Despite its unusual appearance, it is very comfortable to use and shoots extremely accurately."
    },
    {
        "internalName": "M870",
        "shortName": "M870",
        "name": "Remington M870",
        "description": "This pump-action shotgun is one of the most versatile weapons money can buy. It can be used for hunting, home defense, and lock picking.",
        "bobbyRayName": "Remington M870",
        "bobbyRayDescription": "A cherished 12-gauge shotgun for its smooth pump-action, it's a favorite of many police forces around the world. Commonly used as a hunting rifle, it can be found for sale in most local hardware stores."
    },
    {
        "internalName": "SPAS15",
        "shortName": "SPAS-15",
        "name": "SPAS-15",
        "description": "This fearsome looking Italian semi-automatic assault shotgun has been banned in several countries.",
        "bobbyRayName": "SPAS-15",
        "bobbyRayDescription": "The 12-gauge Franchi SPAS-15 shotgun's design is true Italian brilliance. It provides the options for gas, semi-automatic or manual pump action."
    },
    {
        "internalName": "CAWS",
        "shortName": "CAWS",
        "name": "CAWS",
        "description": "This German/US experimental Close Assault Weapon System makes the concept of human skeet shooting a gory reality.",
        "bobbyRayName": "CAWS",
        "bobbyRayDescription": "Olin/Heckler and Koch's Close Assault Weapon System is the ideal light support weapon for any aspiring mercenary. Designed for the 12-guage shotgun shell, it also fires miniature grenades."
    },
    {
        "internalName": "MINIMI",
        "shortName": "Minimi",
        "name": "FN Minimi",
        "description": "This light machine gun, also known as the C-9 and M-249, has been known to moonlight as a beefed-up assault rifle.",
        "bobbyRayName": "FN Minimi",
        "bobbyRayDescription": "Reputed for its reliability, this Belgian machine gun is gas operated, with a simple rotating bolt system. Its design was adopted by the US Army as the M249 machine gun."
    },
    {
        "internalName": "RPK74",
        "shortName": "RPK-74",
        "name": "RPK-74",
        "description": "The latest Russian squad support weapon is this light machine gun. It brings new meaning to the concept of 'spray and pray.'",
        "bobbyRayName": "RPK-74",
        "bobbyRayDescription": "This Russian squad light automatic machine gun is simply a heavy-barreled version of the AK74 rifle. Its only drawback is that it tends to shoot the rifling out of its barrel within 5,000 rounds."
    },
    {
        "internalName": "HK21E",
        "shortName": "H&K 21",
        "name": "H&K 21",
        "description": "This German infantry support weapon is a (not so) light machine gun that helps you pump up while mowing down your opposition.",
        "bobbyRayName": "H&K 21",
        "bobbyRayDescription": "The German Heckler and Koch 21 is a fantastic all-purpose machine gun, featuring a heavy yet easily changeable barrel. Its bipod offers 3 height settings on which the gun can pivot 30 degrees in either direction."
    },
    {
        "internalName": "COMBAT_KNIFE",
        "shortName": "Knife",
        "name": "Combat Knife",
        "description": "This full-tang bowie-styled combat knife will convert you into a whirling, twirling machine of silent, subtle death.",
        "bobbyRayName": "Combat Knife",
        "bobbyRayDescription": "When the enemy is too close for comfort, this full-tang bowie-styled combat knife will definitely come in handy. It features a serrated 9\" blade, and a wooden handle with a heavy-duty guard and pommel."
    },
    {
        "internalName": "THROWING_KNIFE",
        "shortName": "Throw. Knife",
        "name": "Throwing Knife",
        "description": "This finely balanced steel throwing knife brings new meaning to the expression killing them softly. Or, in this case, silently.",
        "bobbyRayName": "Throwing Knife",
        "bobbyRayDescription": "Polish up on your throwing skills with this double-edged chrome-plated high carbon steel blade. This slim little knife is a perfect choice for both novice and experienced throwers."
    },
    {
        "internalName": "ROCK",
        "shortName": "Rock",
        "name": "A Rock",
        "description": "A rock.",
        "bobbyRayName": "A Rock",
        "bobbyRayDescription": "A rock is what you've got in your head if you don't know what one is."
    },
    {
        "internalName": "GLAUNCHER",
        "shortName": "M79",
        "name": "Grenade Launcher",
        "description": "If quick passage through a brick wall or a cluster of bad guys is what you need, the M79, a 40mm US grenade launcher from the Vietnam era, will terminate your troubles every time.",
        "bobbyRayName": "Grenade Launcher",
        "bobbyRayDescription": "Known for its accuracy at longer ranges, the 40mm M79 Grenade Launcher is not your average rifle grenade. This breech loaded, single shot, break-open weapon is usually fired from the shoulder. It features a blade foresight and a folding-leaf adjustable rear sight."
    },
    {
        "internalName": "MORTAR",
        "shortName": "Mortar",
        "name": "Mortar",
        "description": "The M224 is a 60mm caliber lightweight mortar with a finned barrel, sight, M7 base plate, and a bipod. It was built to handle HE bombs.",
        "bobbyRayName": "Mortar",
        "bobbyRayDescription": "Commonly referred to as the battalion commander's artillery, the M224 mortar is a must-have for the serious mercenary commandant. It is a 60mm caliber lightweight mortar with a finned barrel, sight, M7 base plate and bipod, that was built to specifically accommodate HE shells."
    },
    {
        "internalName": "ROCK2",
