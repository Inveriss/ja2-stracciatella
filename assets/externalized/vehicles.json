/**
 * Definitions of player-controllable transport vehicles.
 *
 * The ordering in this list is important, and the game has hard-coded references to the
 * vehicles. For example, the game expects the HELICOPTER to be the 6th vehicle.
 *
 * In base vanilla game, only the Hummer, Ice-cream truck and Helicopter are available.
 *
 * Fields:
 * - enterSound: Sound file to play when a soldier enters the vehicle.
 * - moveSound: Sound file to play when the vehicle moves.
 * - profile: Profile associated to the vehicle.
 * - movementType: Determines if the vehicle can travel through map sectors and how fast. Must be one of FOOT, CAR, TRUCK, TRACKED or AIR.
 * - armourType: Determines the vehicle's protection against damage. Use the internal name of any armour items.
 * - seats: Maximum number of soldiers allowed in the vehicle. Must not be greater than 10.
 * - repairPointsDivisor: Repair points that restore one point of the vehicle's condition (1-100, default 10).
 * - slotLimitMultiplier: The vehicle's cargo pockets hold this many times a merc's limit of an item (1-100, default 1); not for weapons, brass knuckles or money.
 * - tacticalFuelPer100Tiles: Fuel (of 10000, a full tank) 100 tiles of driving on the tactical map cost on a road, twice that off the road (0-10000, default 200).
 * - travelTimePerSector: Minutes a CAR vehicle takes for a road sector on the strategic map (1-200, default 30); through a town always 5.
 * - fuelPerTravelMinute: Fuel (of 10000, a full tank) one minute of travel on the strategic map costs (0-100, default 6).
 */
[
    // Eldorado (unused)
    {
        "enterSound": "sounds/into vehicle.wav", // S_VECH1_INTO
        "moveSound": "sounds/driving 01.wav", // S_VECH1_MOVE
        "profile": "PROF_ELDERODO",
        "movementType": "CAR",
        "armourType": "KEVLAR2_VEST_Y",
        "seats": 6,
        "repairPointsDivisor": 8,
        "slotLimitMultiplier": 4,
        "tacticalFuelPer100Tiles": 400,
        "travelTimePerSector": 20,
        "fuelPerTravelMinute": 18
    },
    // Hummer
    {
        "enterSound": "sounds/into vehicle.wav",
        "moveSound": "sounds/driving 01.wav",
        "profile": "PROF_HUMMER",
        "movementType": "CAR",
        "armourType": "SPECTRA_VEST_Y",
        "seats": 6,
        "repairPointsDivisor": 10,
        "slotLimitMultiplier": 4,
        "tacticalFuelPer100Tiles": 200,
        "travelTimePerSector": 30,
        "fuelPerTravelMinute": 6
    },
    // Ice cream truck
    {
        "enterSound": "sounds/into vehicle.wav",
        "moveSound": "sounds/driving 01.wav",
        "profile": "PROF_ICECREAM",
        "movementType": "CAR",
        "armourType": "FLAK_JACKET_Y",
        "seats": 6,
        "repairPointsDivisor": 4,
        "slotLimitMultiplier": 4,
        "tacticalFuelPer100Tiles": 133,
        "travelTimePerSector": 40,
        "fuelPerTravelMinute": 3
    },
    // Jeep (unused)
    {
        "enterSound": "sounds/into vehicle.wav",
        "moveSound": "sounds/driving 01.wav",
        "profile": "PROF_JEEP",
        "movementType": "CAR",
        "armourType": "KEVLAR_VEST_Y",
        "seats":  6,
        "repairPointsDivisor": 6,
        "slotLimitMultiplier": 4,
        "tacticalFuelPer100Tiles": 200,
        "travelTimePerSector": 30,
        "fuelPerTravelMinute": 6
    },
    // Tank (unused)
    {
        "enterSound": "sounds/into vehicle.wav",
